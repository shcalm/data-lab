      "id": 371638,
      "title": "My Public Apology",
      "author": "tdavis",
      "time_utc": "2008-11-21T07:39:23Z",
      "url": "",
      "hn_url": "https://news.ycombinator.com/item?id=371638",
      "score": 151,
