      "title": "I don't learn anything on HN anymore, bring back the upvote count",
      "author": "wdewind",
      "time_utc": "2011-04-28T21:21:42Z",
      "url": "",
      "hn_url": "https://news.ycombinator.com/item?id=2495137",
