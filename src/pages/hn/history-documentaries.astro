---
import SiteLayout from '../../layouts/SiteLayout.astro';
import Icon from '../../components/Icon.astro';
import { getHistoryDocumentaries } from '../../lib/history-documentaries.mjs';
import { href } from '../../lib/paths';
import '../../styles/school-reading.css';
import '../../styles/history-documentaries.css';
const project = getHistoryDocumentaries();
const { entries, views, collections, discussions } = project;
const download = (file: string) => href(`${project.dataPath}/${file}`);
const jsonData = JSON.stringify(entries.map(({ evidence, note, ...work }) => work)).replaceAll('<', '\\u003c');
---
<SiteLayout title="历史书目与纪录片 · Data Lab" description={project.description} active="history-documentaries">
  <section class="ranking-hero reading-hero" id="top" aria-labelledby="history-title">
    <div class="breadcrumb"><a href={href()}>全部项目</a><span aria-hidden="true">/</span><span>Hacker News</span><span aria-hidden="true">/</span><span>历史与纪录片</span></div>
    <div class="ranking-hero-grid">
      <div><p class="eyebrow">04 / THROUGH TIME &amp; STORIES</p><h1 id="history-title">翻开历史，<br /><span class="green-text">看见来路。</span></h1><p class="ranking-intro">一部历史书，一段真实的影像。从 HN 专门征集推荐的讨论中，收下这些书目与纪录片。沿着地区、人物、战争与科技的线索，寻找下一部想读、想看的作品。</p></div>
      <aside class="reading-overview history-overview" aria-label="专题概要"><span class="eyebrow">历史书目与纪录片 / HACKER NEWS</span><div class="history-overview-counts"><p><b>{views[0].count}</b><span>项历史书目</span></p><p><b>{views[1].count}</b><span>部纪录片与系列</span></p></div><div class="reading-overview-facts"><span>其中 <b>{views[2].count}</b> 部历史纪录片</span><span>来自 <b>{discussions.length}</b> 篇专题讨论</span></div><p>把过去读清楚，也把镜头里的故事留下。</p></aside>
    </div>
    <div class="ranking-hero-bottom"><p>每部有简介与原文，按题材慢慢找。<a href="#history-methodology">了解整理方法 ↗</a></p><div class="download-links"><a href={download('历史书目.csv')} download><Icon name="download" size={16} />书目 CSV</a><a href={download('纪录片单.csv')} download>片单 CSV<Icon name="download" size={16} /></a><a href={download('历史书目与纪录片.zip')} download>全部 ZIP<Icon name="download" size={16} /></a></div></div>
  </section>

  <section class="reading-section" data-history-collection aria-labelledby="collection-title">
    <div class="reading-section-heading"><div><p class="eyebrow">READ THE PAST, WATCH THE WORLD</p><h2 id="collection-title">从一个题材开始</h2></div><a class="text-link" href="#history-downloads">带走书目与片单<Icon name="download" size={16} /></a></div>
    <form class="history-controls" data-history-controls role="search" aria-label="查找历史书目和纪录片" hidden>
      <div class="reading-age-buttons history-view-buttons" role="group" aria-label="选择书目或片单">{views.map((view, i) => <button type="button" data-view={view.id} aria-pressed={i === 0 ? 'true' : 'false'}><span>{view.label}<small>{view.subtitle}</small></span><b class="mono">{view.count}</b></button>)}</div>
      <div class="ranking-tools reading-search-tools"><div class="search-field"><label for="history-search">想读什么，想看什么？</label><div class="input-wrap"><Icon name="search" size={19} /><input type="search" id="history-search" name="q" placeholder="搜索中英文名、作者或内容…" autocomplete="off" /></div></div><div class="select-field"><label for="history-category">按题材筛选</label><div class="select-wrap"><select id="history-category" name="category"><option value="">全部题材</option></select><Icon name="chevron" size={16} /></div></div></div>
    </form>
    <noscript><p class="history-static-note">以下完整列出历史书目和纪录片。也可以下载单独的历史纪录片子集。</p></noscript>
    <div class="list-utility"><p role="status" aria-live="polite" aria-atomic="true"><span data-current-view>全部作品</span> · 显示 <b class="mono" data-result-count>{entries.length}</b> / <span data-view-total>{entries.length}</span><span class="utility-note"> · 专题精选，按题材整理</span></p><div class="list-actions" data-history-actions hidden><button type="button" data-history-reset disabled>清空条件</button></div></div>
    {collections.map(collection => <section class="history-collection" data-history-section={collection.kind} aria-labelledby={`collection-${collection.kind}`}>
      <h2 class="history-collection-title" id={`collection-${collection.kind}`}>{collection.label}<span>{collection.kind === 'books' ? '从文明与战争，到科学与技术' : '从历史回望，到当代生活'}</span></h2>
      {collection.categories.map((category, i) => <section class="reading-category" data-work-group data-kind={collection.kind} data-category={category.name} aria-labelledby={`topic-${collection.kind}-${i}`}>
        <div class="reading-category-heading history-group-heading"><h3 id={`topic-${collection.kind}-${i}`}><span class="mono" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>{category.name}</h3><span><b class="mono" data-category-count>{category.entries.length}</b> 项</span></div>
        <div class="reading-book-grid">{category.entries.map(work => <article class="reading-book history-work" data-work={work.id} id={`work-${work.id}`}>
          <div class="reading-book-heading"><h4><a href={`?view=${collection.kind}#work-${work.id}`}>{work.zh}</a></h4><span class="category-tag">{work.formatLabel}</span></div>
          {work.zh !== work.title && <p class="original-title" lang="en">{work.title}</p>}
          <p class="work-meta">{[work.creator, work.year].filter(Boolean).join(' · ')}</p>
          <p class="reading-summary">{work.summary}</p>
          <div class="reading-book-ages"><span>{work.category}</span>{work.kind === 'documentaries' && work.historyRelated && <span>历史题材</span>}</div>
          <details class="reading-evidence history-evidence"><summary>原文与整理备注<Icon name="chevron" size={14} /></summary><div>
            {work.note && <p>{work.note}</p>}
            <ol>{work.evidence.map(evidence => <li><div class="history-source-heading"><a href={evidence.item_url}>查看原回复<Icon name="arrow-up" size={12} /></a><span>{evidence.stance} · {evidence.created_at.slice(0, 10)}</span></div><blockquote lang="en">{evidence.quote}</blockquote>{evidence.note_zh && <p>{evidence.note_zh}</p>}<a class="history-thread-link" href={evidence.discussion_url}>{evidence.discussion_title}<Icon name="arrow-up" size={12} /></a></li>)}</ol>
          </div></details>
        </article>)}</div>
      </section>)}
    </section>)}
    <div class="empty-state" data-history-empty hidden><Icon name="search" size={30} /><h3>这个题材里暂时没有找到</h3><p>试试更短的关键词，或换一种题材。</p><button class="button" type="button" data-history-reset>清空条件，看看这个列表<Icon name="arrow" size={18} /></button></div>
    <div class="list-end"><span class="mono">A READING &amp; WATCHING COLLECTION</span><a href="#top">回到顶部 ↑</a></div>
    <script type="application/json" id="history-documentaries-data" set:html={jsonData} />
  </section>

  <section class="reading-downloads" id="history-downloads" aria-labelledby="downloads-title"><p class="eyebrow">TAKE A LIST WITH YOU</p><h2 id="downloads-title">留一份，慢慢读，慢慢看。</h2><p>书目和片单分别下载，历史纪录片也有单独的子集。每份包含原名、创作者、年份、类别、完整简介与来源链接。</p><div class="history-download-grid">{views.map(view => <article><h3>{view.label}</h3><p><b class="mono">{view.count}</b> 项作品</p><div>{['csv', 'json', 'md'].map(ext => <a href={download(`${view.file}.${ext}`)} download aria-label={`下载${view.label} ${ext.toUpperCase()}`}>{ext.toUpperCase()}<Icon name="download" size={14} /></a>)}</div></article>)}</div><div class="reading-extra-downloads"><a href={download('历史书目与纪录片.zip')} download>全部内容 ZIP<Icon name="download" size={15} /></a><a href={download('作品原文证据.json')} download>逐条原文证据 JSON<Icon name="download" size={15} /></a><a href={download('讨论来源.json')} download>讨论来源 JSON<Icon name="download" size={15} /></a></div></section>

  <aside class="methodology-note reading-methodology" id="history-methodology" aria-labelledby="method-title"><span class="note-index mono">BEHIND<br />THE COLLECTION</span><div><h2 id="method-title">从讨论里，留下具体的作品。</h2><p>这份专题从 18 篇历史书、科学技术史与纪录片讨论中人工精选。沿用 2016.08.23 至 2026.08.23 UTC 的十年窗口，整理于 2026.11.18；每部保留可核对的原回复与引文。404 条作品引文均与公开评论树和下载的数据快照核对。</p><p>这是书目与片单，未穷尽讨论中的全部作品。推荐、批评、比较和顺带提及会分别标明；保留的证据条数不表示全站热度。历史小说、只有作者或频道名称、无法确认身份的内容未收录。</p><p>「历史纪录片」以历史事件、人物或社会、文化、科技的发展为主要叙事。以同期观察、现场跟拍为主的作品保留在全部片单中，可能具有历史资料价值。书籍系列按一项收录；影视分为 68 部长片、28 部系列和 1 部短片，年份通常采用首版或首播年份。</p><p>简介和分类由本次整理补充。作品中的历史解释与因果判断属于作者视角；存在明确争议或版本辨认限制的条目保留备注。</p><details class="history-discussions"><summary>查看全部 {discussions.length} 篇专题讨论<Icon name="chevron" size={15} /></summary><ol>{discussions.map(discussion => <li><a href={discussion.url}>{discussion.title}<Icon name="arrow-up" size={13} /></a><p>{discussion.date} · {discussion.domain === 'history' ? '历史书目来源' : '纪录片来源'}</p><p>{discussion.reason_zh}</p></li>)}</ol></details></div></aside>
  <script src="../../scripts/history-documentaries.ts"></script>
</SiteLayout>
